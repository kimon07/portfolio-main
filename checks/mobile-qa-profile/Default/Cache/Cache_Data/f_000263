/* Continuously circulating keyword banner */
.keyword-strip{display:block;overflow:hidden;padding:0}
.keyword-track{display:flex;width:max-content;will-change:transform;animation:keyword-marquee 18s linear infinite}
.keyword-group{display:flex;flex:0 0 100vw;align-items:center;justify-content:space-around;gap:12px;padding:22px 4vw}
.keyword-group i{display:inline-block;font-style:normal;font-size:24px}
.keyword-strip:hover .keyword-track{animation-play-state:paused}
@keyframes keyword-marquee{to{transform:translateX(-50%)}}

@media(max-width:600px){.keyword-group{gap:6px;padding:18px 4vw}.keyword-group i{font-size:16px}}
@media(prefers-reduced-motion:reduce){.keyword-track{animation:none}.keyword-group[aria-hidden="true"]{display:none}}
.embedded .project-bar [data-back]{visibility:hidden}
.nesto-open-site{text-align:right;font-size:12px;margin:0 0 18px}.nesto-open-site a{border-bottom:1px solid;padding-bottom:4px}

/* The cover presents the actual storefront across desktop and mobile. */
.cover-showcase{
  container-type:inline-size;
  min-width:0;
  height:auto;
  padding:40px 7% 30px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:30px;
  background:#f1e6d4;
  background:linear-gradient(145deg,#f5edde 0%,#ecd9b9 100%);
}
.showcase-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}
.showcase-heading>strong{font-size:clamp(38px,10cqw,78px);line-height:1;letter-spacing:-.085em;font-weight:900}
.showcase-heading>strong span{display:inline-block;vertical-align:top;font-size:.22em;letter-spacing:0;margin:6px 0 0 5px}
.showcase-heading>p{font-size:clamp(9px,2cqw,14px);line-height:1.35;font-weight:800;letter-spacing:-.025em}
.showcase-screens{position:relative;width:100%;aspect-ratio:1.12}
.showcase-window{overflow:hidden;background:#fff;border:1px solid #d2c6b4;box-shadow:0 16px 32px #674b2520}
.showcase-desktop{position:absolute;top:0;left:0;width:90%;border-radius:6px}
.showcase-browser{height:clamp(16px,3.5cqw,25px);padding:0 3%;display:flex;align-items:center;justify-content:space-between;gap:8px;background:#faf9f5;border-bottom:1px solid #e7e0d6;font-size:clamp(5px,1.1cqw,8px);letter-spacing:.04em}
.showcase-browser>span:first-child{color:#b8ad9c;font-size:.8em;white-space:nowrap}
.cover-showcase .showcase-window img{height:auto;object-fit:contain;object-position:top;width:100%}
.showcase-mobile{position:absolute;right:0;bottom:0;width:29%;border:4px solid #faf9f5;border-radius:15px;box-shadow:0 16px 28px #674b2533,0 0 0 1px #d2c6b4}
.cover-showcase figcaption{position:static;display:flex;flex-direction:row;justify-content:space-between;align-items:end;gap:14px;font-size:clamp(9px,1.8cqw,12px);font-weight:400;line-height:1.7}
.cover-showcase figcaption>span:last-child{text-align:right;font-size:clamp(7px,1.35cqw,9px);font-weight:700;letter-spacing:.04em}
@media(max-width:900px) and (min-width:601px){
  .cover-showcase{padding:30px 6%;gap:24px}
}
@media(max-width:600px){
  .cover-showcase{height:auto;padding:30px 6% 24px;gap:24px}
  .showcase-mobile{border-width:3px;border-radius:10px}
}

/* Mobile case study: readable type and a preview at its native width. */
@media (max-width:700px) {
  :root { --mobile-gutter:clamp(20px,5vw,32px); }
  html { scroll-padding-top:76px; }
  .project-bar { height:60px; padding-inline:var(--mobile-gutter); gap:12px; font-size:10px; letter-spacing:0; }
  .project-bar [data-back] { display:flex; align-items:center; min-height:44px; }
  .project-bar>span:last-child { display:none; }
  .cover { display:flex; flex-direction:column; min-height:0; }
  .cover-copy { padding:36px var(--mobile-gutter) 32px; }
  .eyebrow { font-size:11px; letter-spacing:.07em; }
  .wordmark { font-size:clamp(90px,25vw,130px); margin:8px 0 20px; }
  .wordmark span { margin-top:18px; }
  .cover h1 { font-size:clamp(27px,7vw,36px); line-height:1.45; letter-spacing:-.035em; word-break:keep-all; }
  .lead { font-size:14px; line-height:1.85; margin-top:18px; }
  .lead br,.section-heading>p br,.type-grid p br,.ending p:not(.eyebrow) br { display:none; }
  .text-link { min-height:44px; font-size:14px; margin-top:20px; }
  .facts { grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:28px; padding-top:20px; }
  .facts>div:last-child { display:block; }
  .facts dt { font-size:10px; }
  .facts dd { font-size:12px; line-height:1.6; word-break:keep-all; }
  .cover-image { height:clamp(290px,83vw,460px); }
  .cover-image img { object-position:65% center; }
  .cover-image figcaption { left:var(--mobile-gutter); right:var(--mobile-gutter); bottom:16px; font-size:9px; line-height:1.5; flex-direction:column; gap:4px; }
  .section { padding:56px var(--mobile-gutter); }
  .section h2 { font-size:clamp(27px,7.2vw,36px); line-height:1.3; letter-spacing:-.035em; word-break:keep-all; overflow-wrap:anywhere; }
  .overview { grid-template-columns:minmax(0,1fr); gap:28px; padding-bottom:32px; }
  .prose h3 { font-size:22px; line-height:1.5; letter-spacing:-.025em; word-break:keep-all; }
  .prose p,.principles p,.design-notes p,.section-heading>p,.type-grid p:not(.eyebrow),.ending p:not(.eyebrow) { font-size:14px; line-height:1.85; letter-spacing:0; }
  .principles { grid-template-columns:minmax(0,1fr); gap:28px; padding-top:0; }
  .principles h3,.design-notes h3 { font-size:20px; line-height:1.45; letter-spacing:-.025em; margin:12px 0; }
  .principles span,.design-notes span { font-size:11px; }
  .section-heading { margin-bottom:28px; gap:20px; }
  .section-heading>div { min-width:0; }
  .palette { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .palette>div { height:118px; padding:18px 14px; }
  .palette>div:first-child { grid-column:span 2; grid-row:auto; height:140px; }
  .palette strong,.palette span { font-size:11px; line-height:1.5; }
  .type-grid { grid-template-columns:minmax(0,1fr); margin-top:36px; gap:32px; }
  .type-grid strong { font-size:clamp(32px,9vw,50px); line-height:1.08; letter-spacing:-.04em; }
  .type-grid h3 { font-size:22px; line-height:1.5; word-break:keep-all; }
  .type-grid span { font-size:12px; line-height:1.6; }
  .photo-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px 12px; }
  .photo-grid>figure:first-child { grid-column:span 2; }
  .photo-grid figcaption,.image-note { font-size:11px; line-height:1.7; }
  .preview-controls { flex-direction:column; gap:10px; margin-bottom:12px; }
  .preview-controls>div { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; }
  .preview-controls button { min-height:44px; padding:10px 8px; font-size:12px; }
  .nesto-open-site { font-size:12px; }
  .nesto-open-site a { display:inline-flex; align-items:center; min-height:44px; }
  .preview-stage { min-height:0; margin-inline:calc(-1 * var(--mobile-gutter)); padding:12px; }
  .browser-bar { height:36px; padding-inline:10px; font-size:9px; }
  .browser-bar>span:first-child { display:none; }
  .preview-viewport { height:clamp(440px,72svh,720px); }
  .preview-caption { font-size:12px; line-height:1.7; }
  .design-notes { grid-template-columns:minmax(0,1fr); gap:24px; margin-top:32px; }
  .design-notes article { padding-top:20px; border-top:1px solid var(--line); }
  .ending h2 { font-size:clamp(32px,8.5vw,58px); line-height:1.1; letter-spacing:-.045em; margin:28px 0; }
  .ending h2 span { margin-left:8px; }
  .ending>div { flex-direction:column; align-items:start; gap:24px; }
  .project-footer { flex-direction:column; align-items:start; gap:16px; padding:28px var(--mobile-gutter) max(28px,env(safe-area-inset-bottom)); font-size:10px; line-height:1.6; }
}
